# نمونهٔ تنظیمات سرور
# اگر این مقدار را تنظیم کنید، سرور به یک PostgreSQL واقعی وصل می‌شود.
# در غیر این صورت از PGlite (PostgreSQL به‌صورت WASM) به‌صورت محلی استفاده می‌شود.
# DATABASE_URL=postgres://user:pass@localhost:5432/windows_sim

PORT=4000
HOST=0.0.0.0

# مسیر ذخیرهٔ داده‌های PGlite
PGLITE_DATA_DIR=./.data/pgdata
